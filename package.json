{
  "name": "askdb",
  "productName": "AskDB",
  "version": "1.0.0",
  "description": "Talk to your PostgreSQL database in plain English",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.askdb.app",
    "productName": "AskDB",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AskDB"
    }
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
